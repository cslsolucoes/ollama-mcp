# Binarios compilados (Go) — gerados de src/ para a raiz, nunca versionar
*.exe
# no Windows o go build renomeia o .exe em uso (servidor MCP aberto no cliente) para .exe~
*.exe~
/mcpollama-mcp

# Config de MCP servers project-level — contem o Bearer token do Ollama em texto
# (decisao do owner, Fase 5: token literal nas configs dos clientes, fora do git)
.mcp.json
/.cursor/mcp.json
/.vscode/mcp.json

# Referencias externas e de outros projetos — contem credenciais reais
# (ex.: referencias/MCPVMWare/.mcp.json). Somente leitura, nunca versionar.
# Excecao: o brief (sintese propria, 0 segredos) e versionado.
# Tem de ser `referencias/*` (nao `referencias/`) para a excecao funcionar.
referencias/*
!referencias/Brief_Referencias/

# Estado local de sessao / tooling
.remember/
.claude/settings.local.json

# Toolchains e fontes de terceiros locais (gcc mingw-w64/musl p/ -race e cross-compile;
# fontes de compressao de outros projetos) — grandes, nunca versionar
/deps/
/sdk/
/ZLibSource/
# Fase 7: corpus do spike de PDF (documentos de clientes, NUNCA versionar) e build do OCR
/.workspace/spike-pdf/
/.workspace/build-ocr/
# Fase 8: bake-off de modelos (corpus do owner, saidas dos modelos, mapa de ids) - NUNCA versionar
/.workspace/bakeoff/
# Copias de trabalho (git worktree) dos agentes - locais, nunca versionar
/.claude/worktrees/
# Pack de ferramentas (.cursor canonico + espelhos .claude/.vscode por symlink) - gerido pelo sync do pack, fora do codigo do produto (owner, 2026-10-30)
/.cursor/
/.claude/
/.vscode/

# pastas de smoke test geradas por outras ferramentas (podem conter imagens de clientes)
.workspace/ollama-native-smoke-*/

# Codex: config com o token do Ollama (--api-key), como o .mcp.json; nunca no git
.codex/config.toml
