+
+// keepHyphen looks at the word before the hyphen (the end of before) and the
+// word after the line break (the start of after).
+func keepHyphen(before, after string) bool {
+	j := len(before)
+	for j > 0 {
+		r, n := utf8.DecodeLastRuneInString(before[:j])
+		if !unicode.IsLetter(r) {
+			break
+		}
+		j -= n
+	}
+	k := 0
+	for k < len(after) {
+		r, n := utf8.DecodeRuneInString(after[k:])
