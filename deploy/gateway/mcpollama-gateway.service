[Unit]
Description=mcpollama-gateway: fila na retaguarda + /monitor entre o nginx e o Ollama (Fase 9)
Documentation=file:///root/CONEXAO-IA.md
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=mcpgw
Group=mcpgw
# Fase 9.6 (owner 2026-10-29): qwen3-ia = qwen3.5:9b roda com 1 slot no Ollama -> 1 slot de geracao aqui,
# a espera fica visivel na fila do gateway. Prioridade alta aceita de toda a LAN (owner).
# 2026-11-04 (owner): --gen-slots 3 e --run-timeout 10m (com OLLAMA_NUM_PARALLEL=3; antes 2 e 5 no mesmo dia). O qwen3-ia continua
# gerando 1 por vez (arquitetura qwen35 sem paralelo): os demais esperam dentro do Ollama, contando no run-timeout.
# 2026-10-30 (owner): ate 64 em espera por cliente e por IP, fila total 128 (o rotulo virou
# <maquina>/<usuario>, entao as sessoes do mesmo usuario dividem um cliente).
ExecStart=/usr/local/bin/mcpollama-gateway \
  --listen 127.0.0.1:11500 \
  --ollama 127.0.0.1:11434 \
  --db /var/lib/mcpollama-gateway/gateway.db \
  --gen-slots 3 \
  --run-timeout 10m \
  --embed-slots 2 \
  --priority-ips 10.100.2.0/24 \
  --queue-max 128 \
  --queue-per-client 64 \
  --queue-per-ip 64 \
  --allowed-models "qwen3-ia;nomic-embed-text" \
  --admin-file /etc/mcpollama-gateway/admin \
  --start-stagger 300ms
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mcpollama-gateway
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
