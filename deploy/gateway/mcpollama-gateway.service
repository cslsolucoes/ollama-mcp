[Unit]
Description=mcpollama-gateway: fila na retaguarda + /monitor entre o nginx e o Ollama (Fase 9)
Documentation=file:///root/CONEXAO-IA.md
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=mcpgw
Group=mcpgw
# Fase 9.6 (owner 2026-10-29): qwen3-ia = qwen3.5:9b roda com 1 slot no Ollama -> 1 slot de geracao aqui,
# a espera fica visivel na fila do gateway. Prioridade alta aceita de toda a LAN (owner).
# 2026-11-05 (owner, Fase 12): modelo de producao qwen3.8:27b com o nome real, sem alias (o qwen3-ia deixa de existir);
#   o nome virtual de raciocinio passa a ser qwen3.8:27b-think. Arquitetura qwen35: 1 pedido por vez, como o qwen3.5:9b.
# 2026-11-04 14:46 (owner): de volta a --gen-slots 1 (com OLLAMA_NUM_PARALLEL=1; no mesmo dia passou por 2, 5 e 3); --run-timeout 10m. O qwen3-ia continua
# gerando 1 por vez (arquitetura qwen35 sem paralelo): os demais esperam dentro do Ollama, contando no run-timeout.
# 2026-10-30 (owner): ate 64 em espera por cliente e por IP, fila total 128 (o rotulo virou
# <maquina>/<usuario>, entao as sessoes do mesmo usuario dividem um cliente).
ExecStart=/usr/local/bin/mcpollama-gateway \
  --listen 127.0.0.1:11500 \
  --ollama 127.0.0.1:11434 \
  --db /var/lib/mcpollama-gateway/gateway.db \
  --gen-slots 1 \
  --run-timeout 10m \
  --embed-slots 2 \
  --priority-ips 10.100.2.0/24 \
  --queue-max 128 \
  --queue-per-client 64 \
  --queue-per-ip 64 \
  --allowed-models "qwen3.8:27b;nomic-embed-text" \
  --admin-file /etc/mcpollama-gateway/admin \
  --start-stagger 300ms
# Fase 12 (gateway 0.13.0): erros do modelo -> base de treino. Configurada por VARIAVEL DE AMBIENTE, nao por flag no
# ExecStart, de proposito: o binario 0.12.6 recusa flag desconhecida (sairia com erro e entraria em laco de reinicio),
# mas ignora variavel desconhecida. Assim um rollback so do binario para a 0.12.6 continua subindo com ESTA unit.
# Todas as flags do gateway tem o fallback MCPGW_* (src/cmd/mcpollama-gateway/config.go); a flag, se existisse, venceria.
#   MCPGW_TREINO_DB     treino.db (0600, criado pelo gateway; teto de 2 GiB de dados vivos, 507 acima; FORA do backup comum).
#                       Liga o POST /api/feedback e a aba Erros do monitor. Fica em /var/lib/mcpollama-gateway (ReadWritePaths).
#   MCPGW_DOC_KEY_FILE  chave HMAC (64 hex, mode 0600, dono mcpgw), gerada pelo stage1.sh se nao existir. Sem ela o
#                       /api/feedback responde 503 e nenhum hash e gravado. A MESMA chave vai para o gateway de fallback.
#   MCPGW_ROLE          primario (padrao). Num gateway de fallback, fallback.
# A melhora sem treino (--melhora-* / MCPGW_MELHORA_*) fica DESLIGADA de proposito: so liga depois da medicao do bakeoff
# (C-8.8). Nao acrescente as variaveis MCPGW_MELHORA_* aqui antes disso.
Environment=MCPGW_TREINO_DB=/var/lib/mcpollama-gateway/treino.db
Environment=MCPGW_DOC_KEY_FILE=/etc/mcpollama-gateway/doc.key
Environment=MCPGW_ROLE=primario
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mcpollama-gateway
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
